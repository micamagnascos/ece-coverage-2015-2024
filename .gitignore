# Datos (crudos, intermedios y finales) — pesados y/o de origen restringido
data/raw/*
data/build/*
data/final/*
!data/raw/.gitkeep
!data/build/.gitkeep
!data/final/.gitkeep

*.dta
*.xlsx
*.xls
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.shp.xml
*.csv

# Outputs regenerables
output/figures/*
output/tables/*
!output/figures/.gitkeep
!output/tables/.gitkeep

# legacy/ preserva archivos históricos/huérfanos pero no se versiona por defecto
legacy/*
!legacy/.gitkeep

# OS / Office / editor swap files
.DS_Store
~$*
*.stswp
*.sublime-workspace
*.swp

# Stata
*.log
*.smcl

# Guión y audio de presentaciones — uso personal, no se comparte
slides/guion_*

# Guion personal de presentaciones (no subir)
slides/script_short_term.md

# Excepción: base de cobertura UV-año (datos públicos de transparencia, sin personas).
# Se versiona para tener a mano la versión que se sube al RIS.
!data/final/base_cobertura_cp.dta

# RIS: las estimaciones extraídas (csv) sí se versionan; los guiones de reunión no
!RIS/**/*.csv
RIS/**/guion_reunion.md
